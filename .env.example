# LLM Configuration
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# App Security
SECRET_KEY=change_this_to_a_secure_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# App Environment
# APP_ENV=development enables dev-only behavior on the backend (e.g. looser logs)
APP_ENV=development

# Vite reads this to decide whether to render dev-only UI (e.g. one-click login buttons).
VITE_APP_ENV=development

# Seed
# SEED_PASSWORD is the password used for all initial users created by the seed
# script. The seed refuses to run if this is empty.
SEED_PASSWORD=changeme

# SMTP delivery remains disabled until a real SMTP account is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true

# Database
# Local direct runs default to SQLite. Docker Compose overrides this with its
# local PostgreSQL service.
DATABASE_URL=sqlite:///./sql_app.db
# Docker Compose uses this only for its local PostgreSQL container.
# Set a strong URL-safe value in the ignored .env file.
POSTGRES_PASSWORD=

# Server
HOST=0.0.0.0
PORT=8000